/* Chart visibility styles */
.recharts-wrapper {
  width: 100% !important;
  height: 100% !important;
}

.recharts-surface {
  overflow: visible;
}

/* Ensure chart containers are visible */
.chart-container {
  position: relative;
  width: 100%;
  height: 100%;
  min-height: 300px;
}

@tailwind base;
@tailwind components;
@tailwind utilities;

